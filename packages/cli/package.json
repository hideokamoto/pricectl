{
  "name": "@pricectl/cli",
  "version": "0.1.0",
  "description": "CLI for pricectl - Control your pricing infrastructure",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "pricectl": "./bin/run"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "test": "jest --passWithNoTests",
    "lint": "eslint src --ext .ts"
  },
  "keywords": ["stripe", "iac", "cli"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hideokamoto/pricectl.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/hideokamoto/pricectl/tree/master/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/hideokamoto/pricectl/issues"
  },
  "author": {
    "name": "Hidetaka Okamoto",
    "url": "https://github.com/hideokamoto"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@pricectl/core": "workspace:*",
    "@pricectl/constructs": "workspace:*",
    "@oclif/core": "^3.27.0",
    "@oclif/plugin-help": "^6.3.0",
    "stripe": "^23.0.0",
    "chalk": "^4.1.2",
    "diff": "^5.2.2",
    "esbuild-register": "^3.6.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@oclif/test": "^3.2.15",
    "@types/diff": "^5.2.3"
  },
  "oclif": {
    "bin": "pricectl",
    "commands": "./dist/commands",
    "hooks": {
      "init": "./dist/hooks/init"
    },
    "plugins": [
      "@oclif/plugin-help"
    ],
    "topicSeparator": " "
  }
}
