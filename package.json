{
  "name": "@pricectl/monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "pricectl - Infrastructure as Code for Stripe pricing resources",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "clean": "pnpm -r clean",
    "test:e2e": "jest --config test/e2e/jest.config.js --runInBand",
    "release": "pnpm -r run clean && pnpm -r run build && pnpm -r publish"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.43",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "jest": "^29.7.0",
    "jest-junit": "^17.0.0",
    "prettier": "^3.9.10",
    "rimraf": "^5.0.10",
    "ts-jest": "^29.4.14",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "minimatch@9": "^9.0.9"
    }
  },
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hideokamoto/pricectl.git"
  },
  "homepage": "https://github.com/hideokamoto/pricectl#readme",
  "bugs": {
    "url": "https://github.com/hideokamoto/pricectl/issues"
  },
  "author": "hideokamoto",
  "license": "MIT"
}
